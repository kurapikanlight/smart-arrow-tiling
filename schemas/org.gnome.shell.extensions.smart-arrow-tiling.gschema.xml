<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.smart-arrow-tiling"
          path="/org/gnome/shell/extensions/smart-arrow-tiling/">

    <key name="tile-left" type="as">
      <default><![CDATA[['<Super>Left']]]></default>
      <summary>Smart tile left</summary>
    </key>

    <key name="tile-right" type="as">
      <default><![CDATA[['<Super>Right']]]></default>
      <summary>Smart tile right</summary>
    </key>

    <key name="tile-up" type="as">
      <default><![CDATA[['<Super>Up']]]></default>
      <summary>Move to the upper slot or complete a diagonal sequence</summary>
    </key>

    <key name="tile-down" type="as">
      <default><![CDATA[['<Super>Down']]]></default>
      <summary>Move to the lower slot or complete a diagonal sequence</summary>
    </key>

  </schema>
</schemalist>
